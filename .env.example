# ==============================================================================
# BREVO EMAIL SENDER CONFIGURATION
# ==============================================================================
# 1. Sign in to https://app.brevo.com
# 2. Go to: Settings / SMTP & API -> API Keys -> Generate a new API Key
# 3. Go to: Senders & IP -> Senders -> Add and verify your sender email domain / address
BREVO_API_KEY="your-brevo-api-key-here"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Eventeev"

# Brevo SMTP Configuration (Use if configuring Supabase Auth SMTP or external SMTP clients)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your-brevo-login-email@example.com"
BREVO_SMTP_PASSWORD="your-brevo-smtp-key-here"

# ==============================================================================
# APPLICATION & API CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_URL="https://eventeevapi.onrender.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_SENTRY_DSN=""
